# Database
DATABASE_URL="mongodb://localhost:27017/syntaxlab"

# NextAuth Configuration
AUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# Google OAuth (Optional)
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Server-side encryption key for saved Ollama Cloud API keys.
# Use a long random value in production; AUTH_SECRET is used as a fallback.
OLLAMA_CONFIG_ENCRYPTION_KEY="replace-with-a-long-random-secret"

# Development
NODE_ENV="development"

